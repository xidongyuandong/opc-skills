# Optional local environment for marketplace-zxgc maintenance.
#
# Copy this file outside the repository, for example:
#   mkdir -p "$HOME/.config/marketplace-zxgc"
#   cp docs/marketplace-zxgc.env.example "$HOME/.config/marketplace-zxgc/env"
#
# Then edit the copied file. Do not commit real tokens.

# Either variable name is accepted by scripts/push-marketplace.sh.
GITLAB_PERSONAL_ACCESS_TOKEN=
# GITLAB_TOKEN=

# Optional task2zxgc runtime configuration.
# These values are machine-specific; keep the edited copy outside the repository.
# CODEX_HOME=$HOME/.codex
# MARKETPLACE_ZXGC_HOME=$HOME/marketplace-zxgc
# TASK2ZXGC_REPO_URL=https://gitlab.chehejia.com/ep/ai/ai-coding-zxgc-managment.git
# TASK2ZXGC_REPO_DIR=$HOME/.codex/task2zxgc/ai-coding-zxgc-managment
# TASK2ZXGC_USERNAME=
# AI_INSIGHTS_REPO=$HOME/ai-insights
