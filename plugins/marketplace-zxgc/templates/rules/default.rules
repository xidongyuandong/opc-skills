# marketplace-zxgc managed Codex rules template.
#
# Scope:
# - Keep this file small, portable, and free of secrets.
# - Add only stable command prefixes that are safe for marketplace maintenance,
#   validation, local inspection, and non-destructive Git review.
# - Do not encode local absolute paths or one-repository-only commands in this
#   shared template. Convert those entries into install documentation or local
#   scripts owned by the target machine/repository.
# - Do not store tokens, raw auth commands, cookies, private keys, internal
#   credential values, or task-specific command transcripts here.

prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["nl"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")

prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "remote"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")

prefix_rule(pattern=["jq", "empty"], decision="allow")
prefix_rule(pattern=["bash", "-n"], decision="allow")

prefix_rule(pattern=["codex", "plugin", "marketplace", "add"], decision="allow")
prefix_rule(pattern=["codex", "plugin", "marketplace", "list"], decision="allow")
prefix_rule(pattern=["codex", "plugin", "marketplace", "upgrade"], decision="allow")
prefix_rule(pattern=["codex", "plugin", "list"], decision="allow")
